# Copy this file to `.env` (it is git-ignored) when running the frontend.
#
# Local development (backend on your machine):
VITE_API_BASE=http://localhost:8000
#
# Production: set this in your host's dashboard (Vercel/Netlify) to your
# deployed backend URL, e.g.
# VITE_API_BASE=https://euromotion-backend.onrender.com
